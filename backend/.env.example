APP_NAME=Resolvix
APP_VERSION=0.2.0
APP_ENV=development
DEBUG=True

# Database
# Requires PostgreSQL with the pgvector extension (see ../docs/pgvector-setup.md)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/resolvix_db
DB_CONNECT_TIMEOUT=5

# Authentication
# Generate a real secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit the real value.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=resolvix
JWT_AUDIENCE=resolvix-api
ACCESS_TOKEN_EXPIRE_MINUTES=30

# Cookie sessions. The browser never receives tokens through JavaScript.
# Refresh tokens are stored hashed in PostgreSQL and slide forward on use.
REFRESH_TOKEN_EXPIRE_DAYS=30
ACCESS_TOKEN_COOKIE_NAME=resolvix_access
REFRESH_TOKEN_COOKIE_NAME=resolvix_refresh
# Set to true for HTTPS deployments. SameSite=none requires secure cookies.
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
# Optional cookie domain, e.g. .resolvix.example.com. Leave blank for host-only.
COOKIE_DOMAIN=

# CORS (JSON list). Add deployed frontend origins explicitly.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# LLM Provider
# Use "gemini" for hosted inference or "ollama" for local inference.
LLM_PROVIDER=gemini

# Gemini model. Ollama uses OLLAMA_MODEL instead.
LLM_MODEL=gemini-3.5-flash-lite

# Generic fallback key for providers without a dedicated variable.
# Gemini prefers GEMINI_API_KEY below.
LLM_API_KEY=
# Reserved for future OpenAI-compatible providers.
LLM_BASE_URL=
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# Ollama (local inference, no API key required)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b

# Knowledge / RAG
# The local embedding model must produce 384-dimensional vectors to match
# knowledge_chunks.embedding. The same model embeds chunks and queries.
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
EMBEDDING_DEVICE=cpu
EMBEDDING_BATCH_SIZE=32

# Chunk sizes are model tokens, not characters. Keep the maximum below the
# model's 256-token limit so text is never silently truncated.
KNOWLEDGE_CHUNK_MAX_TOKENS=200
KNOWLEDGE_CHUNK_OVERLAP_TOKENS=40

# Retrieval returns the nearest active chunks whose cosine distance is within
# the threshold. 0.0 is identical; 2.0 is opposite.
RAG_TOP_K=4
RAG_MAX_DISTANCE=0.7

# Support-agent orchestration
# Message rows loaded before the bounded provider history is assembled. Tool
# rows are included so follow-up turns can reuse the last successful order.
AGENT_CONTEXT_MESSAGE_LIMIT=100
AGENT_MAX_HISTORY_MESSAGES=40
AGENT_MAX_HISTORY_CHARS=12000
# Hard limits for the model -> validate -> execute -> tool-result loop.
AGENT_MAX_TOOL_ROUNDS=3
AGENT_MAX_TOOL_CALLS=6

# Provider API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
