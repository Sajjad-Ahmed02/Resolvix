APP_NAME=Resolvix
APP_VERSION=0.2.0
APP_ENV=development
DEBUG=True

# Database
# Requires PostgreSQL with the pgvector extension (see ../docs/pgvector-setup.md)
DATABASE_URL=postgresql+psycopg://postgres:password@localhost:5432/resolvix_db
DB_CONNECT_TIMEOUT=5

# Authentication
# Generate a real secret with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
# Never commit the real value.
JWT_SECRET_KEY=replace-with-a-random-secret-at-least-32-characters
JWT_ALGORITHM=HS256
JWT_ISSUER=resolvix
JWT_AUDIENCE=resolvix-api
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (JSON list). Add deployed frontend origins explicitly.
CORS_ORIGINS=["http://localhost:5173","http://127.0.0.1:5173"]

# LLM Provider
LLM_PROVIDER=gemini
LLM_MODEL=gemini-2.5-flash
LLM_API_KEY=
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai/
LLM_TIMEOUT=60
LLM_TEMPERATURE=0.7
LLM_MAX_TOKENS=2048

# Ollama
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Provider API Keys
GEMINI_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=
GROQ_API_KEY=
