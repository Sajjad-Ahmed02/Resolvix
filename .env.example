# Docker Compose environment for Resolvix.
#
# Copy this file to `.env` before the first `docker compose up`:
#   Copy-Item .env.example .env
#
# Generate a real JWT secret and paste it after JWT_SECRET_KEY=:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"

# ---------------------------------------------------------------
# PostgreSQL (pgvector image)
# ---------------------------------------------------------------
POSTGRES_DB=resolvix
POSTGRES_USER=resolvix
# Change this before exposing the stack outside your machine. Use letters,
# digits, and -_.~ only: the value is embedded in the backend DATABASE_URL.
POSTGRES_PASSWORD=resolvix-local-password

# ---------------------------------------------------------------
# Application
# ---------------------------------------------------------------
# Compose refuses to start while this value is empty.
JWT_SECRET_KEY=
COOKIE_SECURE=false
COOKIE_SAMESITE=lax
LOG_LEVEL=INFO
LOG_FORMAT=json

BACKEND_PORT=8000
FRONTEND_PORT=5173
# Origin the browser uses to reach the API. Change this for a remote host.
VITE_API_BASE_URL=http://localhost:8000

# First boot runs idempotent seeding and knowledge indexing. Set either to
# false to shorten startup once the database is prepared.
SEED_DATABASE=true
INDEX_KNOWLEDGE=true

# ---------------------------------------------------------------
# LLM provider
# ---------------------------------------------------------------
# gemini (hosted) or ollama (local, use the optional compose profile).
LLM_PROVIDER=gemini
LLM_MODEL=gemini-3.5-flash-lite
GEMINI_API_KEY=

# Used only with: docker compose --profile ollama up -d
OLLAMA_BASE_URL=http://ollama:11434
OLLAMA_MODEL=llama3.2:3b
